next-env.d.ts




# .gitignore - MASI FAST RESULTS (PRO MAX VERSION)

# ============================================================
# 🔥 PYTHON (Backend)
# ============================================================
# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Environment variables
.env
.env.local
.env.*.local
!.env.example
!.env.sample

# Database
*.db
*.sqlite
*.sqlite3
*.db-journal

# Backend uploads/media
backend/uploads/
uploads/
media/
static/uploads/
static/media/

# Logs
*.log
logs/
*.log.*

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
*.cover

# Docker
*.pid
*.seed
*.pid.lock

# ============================================================
# 🔥 NODE.JS / NEXT.JS (Frontend)
# ============================================================
# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo

# Vercel
.vercel/
.vercel_output/

# ============================================================
# 🔥 IDE & EDITORS
# ============================================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# IntelliJ / PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.~*

# ============================================================
# 🔥 OS & SYSTEM
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.directory-*

# ============================================================
# 🔥 OTHER
# ============================================================
# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Secrets/Keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Reports
*.pdf
*.xlsx
*.csv

# Coverage
.coverage
htmlcov/

